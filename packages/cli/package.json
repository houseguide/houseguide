{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@houseguide/cli",
  "description": "Teach your coding agent the house rules.",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "private": false,
  "homepage": "https://houseguide.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houseguide/houseguide.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "hg": "dist/index.js",
    "houseguide": "dist/index.js"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts src/agents/project-reader.ts --outdir dist --entry-naming '[name].js' --target node --format esm"
  },
  "exports": {
    ".": {
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/project-reader.js",
    "catalog/instructions.md",
    "catalog/structure.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
