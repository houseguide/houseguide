{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@houseguide/workspace",
  "description": "Teach your coding agent the house rules.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "homepage": "https://houseguide.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houseguide/houseguide.git",
    "directory": "."
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/website dev",
    "build": "bun run --filter '*' --if-present build",
    "test": "bun test",
    "typecheck": "bun check",
    "lint": "biome check",
    "format": "biome format --write",
    "postinstall": "lefthook install",
    "changeset": "changeset",
    "version-packages": "changeset version && bun install --lockfile-only",
    "publish-packages": "bun run prepare-release && changeset pack --out-dir out/release && changeset publish --from-pack-dir out/release",
    "prepare-release": "bun run --cwd packages/cli build && bun scripts/prepare-release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.5",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.5"
}
